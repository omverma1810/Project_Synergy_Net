# ── Synergy Net · Frontend environment ──────────────────────────────
# Copy to .env.local for local development.

# Server-side: where Next.js rewrites proxy /api/* requests.
# Local dev → Django on localhost. Production → your Cloud Run URL.
API_URL=http://localhost:8000

# Client API base used by src/lib/api.ts.
#   /api  → use the same-origin Next.js proxy (recommended; no CORS).
#   https://your-backend/api → call the backend directly (requires CORS, must include /api).
NEXT_PUBLIC_API_URL=/api
