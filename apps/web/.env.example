# ── Synergy Net · Frontend environment ──────────────────────────────
# Copy to .env.local for local development.

# Server-side: where Next.js rewrites proxy /api/* requests.
# Local dev → Django on localhost. Production → your Cloud Run URL.
API_URL=http://localhost:8000

# Public (browser-exposed) API base. Usually same host as the app via /api proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000
